# AutoWSGR v2 — 旧配置归档 (已迁移的段已注释)
# ==========================================
# 迁移规则: 新架构用到的配置段迁至新 usersettings.yaml,
# 迁移后在此处注释掉; 本文件保留未迁移段, 供后续逐条链路迁移时取用。
#
# 已迁移 → 新 usersettings.yaml:
#   emulator / account / ocr / log  (初始化链路 launch 第一阶段所需)
#
# 待迁移 (保留在下方, 对应业务链路重塑时再迁):
#   脚本行为 / 解装设置 / 数据路径 / daily_automation / decisive_battle

# ═══════════════════════════════════════════
# 模拟器配置 — 已迁移至新 usersettings.yaml
# ═══════════════════════════════════════════
# emulator:
#   type: MuMu                       # 雷电 / 蓝叠 / MuMu / 夜神 / 逍遥 / WAYDROID
#   path: null                       # 模拟器可执行文件路径; null = 自动检测
#   serial: null                     # ADB serial 地址; null = 自动检测
#   process_name: null               # 模拟器进程名; null = 自动推断

# ═══════════════════════════════════════════
# 游戏账号 — 已迁移至新 usersettings.yaml
# ═══════════════════════════════════════════
# account:
#   game_app: 官服                   # 官服 / 小米服 / 应用宝服

# ═══════════════════════════════════════════
# OCR 引擎 — 已迁移至新 usersettings.yaml
# ═══════════════════════════════════════════
# ocr:
#   gpu: false                       # 是否使用 GPU 加速
#   mirror: modelscope               # Easyocr 模型镜像
#   ship_name_match_confidence: 0.65 # 舰名匹配置信度
#   ship_name_corrections: {}        # OCR误识别文字 -> SHIPNAMES标准舰名
#   ship_name_aliases:               # 用户自定义名 -> SHIPNAMES标准舰名
#     希尔德布兰德: AIII
#     契卡洛夫: 85工程
#     U-47·狼群: U-47
#     巴尔的摩·英魂: 巴尔的摩

# ═══════════════════════════════════════════
# 日志 — 已迁移至新 usersettings.yaml
# ═══════════════════════════════════════════
# log:
#   level: DEBUG
#   root: logs
#   show_decisive_battle_info: true
#   show_emulator_debug: false
